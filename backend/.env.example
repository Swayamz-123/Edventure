# Copy to .env locally; never commit real secrets.
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
MONGO_URI=mongodb://127.0.0.1:27017/edventure
SESSION_SECRET=replace-with-a-long-random-secret
# Optional fallback for older deployments; prefer SESSION_SECRET.
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEMINI_API_KEY=
GEMINI_API_KEY_CHATBOT=
DEEPSEEK_API_KEY_CHATBOT=
GEMINI_QUIZ_MODEL=gemini-2.5-flash
GEMINI_CHAT_MODEL=gemini-2.5-flash
DEEPSEEK_CHAT_MODEL=deepseek-chat
# Enable only behind a single trusted reverse proxy.
TRUST_PROXY=false
